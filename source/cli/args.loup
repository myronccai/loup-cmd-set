@mode(host.dual)

# Command-line parsing for set. cmd's SET takes the rest of the command line
# as one text, so the arguments are joined with spaces:
#
#   set                  list every variable
#   set PREFIX           list the variables whose names start with PREFIX
#   set NAME=value       assign (lasts only for this command here)
#   set /A expression    evaluate and print an arithmetic expression
#
# `/?` (or `-?`) asks for help, following the Windows switch convention in
# win/switches.loup; `--` ends switch parsing.
#
# Runtime: host.dual. Compiled into the native binary build/set by `make
# build`; `loup run source/main.loup` interprets the same code.

from win.messages import (MSG_SYNTAX);
from win.switches import (SwitchSpec, parse_switches);

pub const MODE_LIST: int = 0;
pub const MODE_SHOW: int = 1;
pub const MODE_ASSIGN: int = 2;
pub const MODE_ARITH: int = 3;

pub const MSG_NO_PROMPT: string = "set /P (prompt for a value) is not supported by this version.";

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub mode: int;
    pub text: string;   # the prefix, the assignment or the expression
}

func options(mode: int, text: string): Options {
    return Options(help = false, version = false, mode = mode, text = text);
}

# The text of a quoted argument the way cmd reads `set "NAME=value"`: from
# after the first quote to the last one.
pub func strip_quotes(text: string): string {
    if (!text.startsWith("\"")) {
        return text;
    }
    var last = -1;
    var i = 0;
    for (ch in text) {
        if (ch == "\"") {
            last = i;
        }
        i += 1;
    }
    if (last <= 0) {
        return text.slice(1);
    }
    return text.slice(1, last);
}

# The words after the first argument, joined with spaces.
func rest_of(words: list[string], first: string): string {
    var parts: list[string] = [first];
    for (k in 1..words.len()) {
        parts.push(words[k]);
    }
    return parts.join(" ").trim();
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let none: list[SwitchSpec] = [];
    let parsed = match parse_switches(argv, none) {
        Ok(p) => p,
        Err(e) => {
            return Err(MSG_SYNTAX);
        },
    };
    if (parsed.help or parsed.version) {
        return Ok(Options(help = parsed.help, version = parsed.version, mode = MODE_LIST, text = ""));
    }
    let words = parsed.operands;
    if (words.len() == 0) {
        return Ok(options(MODE_LIST, ""));
    }
    let first = words[0];
    let upper = first.toUpperCase();
    if (upper == "/A" or upper == "-A" or upper.startsWith("/A")) {
        return Ok(options(MODE_ARITH, rest_of(words, first.slice(2))));
    }
    if (upper == "/P" or upper == "-P" or upper.startsWith("/P")) {
        return Err(MSG_NO_PROMPT);
    }
    let raw = words.join(" ");
    let text = strip_quotes(raw);
    let eq = text.index_of("=");
    if (eq < 0) {
        return Ok(options(MODE_SHOW, text));
    }
    let name = text.slice(0, eq);
    if (name.len() == 0 or (name.startsWith("/") and !raw.startsWith("\""))) {
        return Err(MSG_SYNTAX);
    }
    return Ok(options(MODE_ASSIGN, text));
}
