@mode(host.dual)

# Top level of set: parse the arguments, handle /? and --version, run the
# command and turn the outcome into cmd's ERRORLEVEL.
#
# Runtime: host.dual. Compiled into the native binary build/set by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly.

from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.setcmd import (run_set);

# Parses argv, runs set and returns the exit status (cmd's ERRORLEVEL).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_FAILURE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_set(opts);
    } catch (Exception as e) {
        printErr(e.message);
        return EXIT_FAILURE;
    }
}
