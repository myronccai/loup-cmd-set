@mode(host.dual)

# Unit tests for set's exit statuses over whole command lines
# (cli.app.run). These tests print the program's normal output.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);
from commands.arith import (ERR_DIVIDE_BY_ZERO);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_show_and_arith(): void {
    expectEq(run(["PATH"]), EXIT_OK, "PATH is set");
    expectEq(run(["NO_SUCH_VARIABLE_PREFIX_X"]), EXIT_FAILURE, "nothing matches");
    expectEq(run(["/a", "6*7"]), EXIT_OK, "arithmetic");
    expectEq(run(["/a", "1/0"]), ERR_DIVIDE_BY_ZERO, "cmd's ERRORLEVEL");
    expectEq(run(["X=1"]), EXIT_OK, "assignment");
    expectEq(run(["/a"]), EXIT_FAILURE, "empty expression");
}
