@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, strip_quotes, MODE_LIST, MODE_SHOW, MODE_ASSIGN, MODE_ARITH,
    MSG_NO_PROMPT);

func same(got: string, want: string, what: string): void {
    expect(got == want, what + ": got '" + got + "', want '" + want + "'");
}

func test_list(): void {
    let none: list[string] = [];
    expectEq(parse_args(none).unwrap().mode, MODE_LIST, "no arguments");
}

func test_show_prefix(): void {
    let opts = parse_args(["PA"]).unwrap();
    expectEq(opts.mode, MODE_SHOW, "prefix");
    same(opts.text, "PA", "prefix text");
    same(parse_args(["\"PA\""]).unwrap().text, "PA", "quoted prefix");
    same(parse_args(["two", "words"]).unwrap().text, "two words", "joined");
}

func test_assign(): void {
    let opts = parse_args(["X=1"]).unwrap();
    expectEq(opts.mode, MODE_ASSIGN, "assignment");
    same(opts.text, "X=1", "text");
    same(parse_args(["\"X=a b\" ignored"]).unwrap().text, "X=a b", "quoted assignment");
    expect(parse_args(["=1"]).is_err(), "no name");
    expect(parse_args(["/x=1"]).is_err(), "unquoted name starting with /");
    expectEq(parse_args(["\"/x=1\""]).unwrap().mode, MODE_ASSIGN, "quoted / name");
}

func test_arith(): void {
    let opts = parse_args(["/A", "1", "+", "2"]).unwrap();
    expectEq(opts.mode, MODE_ARITH, "/A");
    same(opts.text, "1 + 2", "expression words joined");
    same(parse_args(["/a3*4"]).unwrap().text, "3*4", "glued");
    same(parse_args(["-a", "x=1"]).unwrap().text, "x=1", "-a");
    same(parse_args(["/A"]).unwrap().text, "", "empty expression");
}

func test_prompt_not_supported(): void {
    same(parse_args(["/P", "x=Name? "]).unwrap_err(), MSG_NO_PROMPT, "/P");
}

func test_strip_quotes(): void {
    same(strip_quotes("plain"), "plain", "no quotes");
    same(strip_quotes("\"a=b\" rest"), "a=b", "up to the last quote");
    same(strip_quotes("\"a=b"), "a=b", "no closing quote");
}

func test_help_and_version(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["/a", "1", "-?"]).unwrap().help, "-? anywhere");
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
    same(parse_args(["--", "/?"]).unwrap().text, "/?", "/? after --");
}
